    <file alias="qml/TimelineView.qml">../qml/TimelineView.qml</file>
    <file alias="qml/Timeline.js">../qml/Timeline.js</file>
    <file alias="qml/ChoicePicker.qml">../qml/ChoicePicker.qml</file>
